<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 15 draws apps behind the system bars by default. Opting out
         keeps the editor and its status line clear of them and the keyboard. -->
    <style name="Theme.TextEditor" parent="android:Theme.Material.Light.DarkActionBar">
        <item name="android:colorPrimary">@color/primary</item>
        <item name="android:colorPrimaryDark">@color/primary_dark</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
