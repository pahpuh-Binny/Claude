#!/bin/sh
# rgds-switch-os: pick which OS the RG DS microSD card boots.
#
#   rgds-switch-os kali | rocknix | <LABEL>   make it the default, then reboot
#   rgds-switch-os android                    power off; take the card out to boot Android
#   rgds-switch-os status                     list the boot entries and the default
#
#   --no-reboot   change the default without rebooting / powering off
#
# U-Boot on the RG DS has no on-screen menu, so the card's extlinux.conf
# DEFAULT line decides what boots. This script edits that one line. It runs
# on Kali (boot partition at /boot/rgds-multiboot) and on ROCKNIX (/flash),
# and uses only POSIX sh + busybox-compatible tools.
set -eu

REBOOT=1
TARGET=""
for arg in "$@"; do
  case $arg in
    --no-reboot) REBOOT=0 ;;
    -h|--help) sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*) echo "unknown option: $arg" >&2; exit 2 ;;
    *) TARGET=$arg ;;
  esac
done
[ -n "$TARGET" ] || TARGET=status

say() { printf '%s\n' "$*"; }
die() { printf 'rgds-switch-os: %s\n' "$*" >&2; exit 1; }

if [ "$TARGET" = android ]; then
  say "Android lives on the internal storage and starts when no microSD card is inserted."
  say "Power off, remove the card, then power on."
  if [ "$REBOOT" = 1 ]; then sync; sleep 3; poweroff; fi
  exit 0
fi

BOOT_DIR=""
for d in ${RGDS_BOOT_DIR:-} /boot/rgds-multiboot /flash; do
  if [ -f "$d/extlinux/extlinux.conf" ]; then BOOT_DIR=$d; break; fi
done
[ -n "$BOOT_DIR" ] || die "cannot find the card's extlinux/extlinux.conf (is the boot partition mounted?)"
CONF="$BOOT_DIR/extlinux/extlinux.conf"

labels() {
  sed -n 's/^[[:space:]]*[Ll][Aa][Bb][Ee][Ll][[:space:]][[:space:]]*\([^[:space:]]*\).*/\1/p' "$CONF"
}
current_default() {
  sed -n 's/^[[:space:]]*[Dd][Ee][Ff][Aa][Uu][Ll][Tt][[:space:]][[:space:]]*\([^[:space:]]*\).*/\1/p' "$CONF" | tail -n 1
}
upper() { printf '%s' "$1" | tr '[:lower:]' '[:upper:]'; }

if [ "$TARGET" = status ]; then
  def=$(current_default)
  say "boot config: $CONF"
  for l in $(labels); do
    if [ "$l" = "$def" ]; then say "* $l (default)"; else say "  $l"; fi
  done
  say "  android (boots when the card is removed)"
  exit 0
fi

# Resolve the target to a LABEL: exact match first, then case-insensitive,
# then "rocknix" means the first entry that is not KALI.
want=$(upper "$TARGET")
LABEL=""
for l in $(labels); do
  if [ "$l" = "$TARGET" ]; then LABEL=$l; break; fi
done
if [ -z "$LABEL" ]; then
  for l in $(labels); do
    if [ "$(upper "$l")" = "$want" ]; then LABEL=$l; break; fi
  done
fi
if [ -z "$LABEL" ] && [ "$want" = ROCKNIX ]; then
  for l in $(labels); do
    if [ "$(upper "$l")" != KALI ]; then LABEL=$l; break; fi
  done
fi
[ -n "$LABEL" ] || die "no boot entry called '$TARGET' (have: $(labels | tr '\n' ' '))"

# ROCKNIX mounts /flash read-only; open it up just for the write.
remounted=0
opts=$(awk -v m="$BOOT_DIR" '$2 == m { print $4 }' /proc/mounts 2>/dev/null | tail -n 1)
case $opts in
  ro|ro,*) mount -o remount,rw "$BOOT_DIR" && remounted=1 ;;
esac

tmp="$CONF.rgds-tmp"
awk -v label="$LABEL" '
  BEGIN { done = 0 }
  {
    line = $0; sub(/^[ \t]+/, "", line)
    if (tolower(substr(line, 1, 7)) == "default" && (length(line) == 7 || substr(line, 8, 1) ~ /[ \t]/)) {
      if (!done) { print "DEFAULT " label; done = 1 }
      next
    }
    if (!done && line != "" && substr(line, 1, 1) != "#") { print "DEFAULT " label; done = 1 }
    print
  }
  END { if (!done) print "DEFAULT " label }
' "$CONF" > "$tmp"
sync
mv "$tmp" "$CONF"
sync

if [ "$remounted" = 1 ]; then mount -o remount,ro "$BOOT_DIR" || true; fi

say "Next boot: $LABEL"
if [ "$REBOOT" = 1 ]; then
  say "Rebooting..."
  sleep 2
  if command -v systemctl >/dev/null 2>&1; then systemctl reboot; else reboot; fi
fi
