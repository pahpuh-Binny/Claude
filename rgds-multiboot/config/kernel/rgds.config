# Kernel config fragment for the Anbernic RG DS (RK3568), merged on top of
# arm64 defconfig by scripts/build-kernel.sh. Symbols that do not exist in the
# chosen kernel version are dropped by merge_config.sh with a warning.

CONFIG_LOCALVERSION="-rgds"
CONFIG_ARCH_ROCKCHIP=y

# Root filesystem on the microSD card must mount without an initramfs.
CONFIG_MMC_DW=y
CONFIG_MMC_DW_ROCKCHIP=y
CONFIG_MMC_SDHCI_OF_DWCMSHC=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_EXFAT_FS=m
CONFIG_NTFS3_FS=m
CONFIG_SQUASHFS=m

# Both 640x480 screens: VOP2 -> DSI0 / DSI1 -> Jadard JD9365DA-H3 panels.
CONFIG_DRM_ROCKCHIP=m
CONFIG_ROCKCHIP_VOP2=y
CONFIG_ROCKCHIP_DW_MIPI_DSI=y
CONFIG_PHY_ROCKCHIP_INNO_DSIDPHY=m
CONFIG_DRM_PANEL_JADARD_JD9365DA_H3=m
CONFIG_BACKLIGHT_PWM=m
CONFIG_ROCKCHIP_IOMMU=y
# Mali-G52 GPU (Mesa "panfrost").
CONFIG_DRM_PANFROST=m

# Two Goodix GT911 touch panels (i2c3 = top, i2c5 = bottom).
CONFIG_TOUCHSCREEN_GOODIX=m

# Buttons, analog sticks, lid switch, rumble, LEDs.
CONFIG_INPUT_JOYSTICK=y
CONFIG_JOYSTICK_ADC=m
CONFIG_KEYBOARD_ADC=m
CONFIG_KEYBOARD_GPIO=m
CONFIG_ROCKCHIP_SARADC=m
CONFIG_MULTIPLEXER=m
CONFIG_MUX_GPIO=m
CONFIG_IIO_MUX=m
CONFIG_INPUT_PWM_VIBRA=m
CONFIG_INPUT_UINPUT=m
CONFIG_LEDS_PWM=m

# RK817 PMIC, charger, codec; SYR827 CPU regulator; CW2015 fuel gauge.
CONFIG_MFD_RK8XX_I2C=y
CONFIG_REGULATOR_RK808=y
CONFIG_REGULATOR_FAN53555=y
CONFIG_RTC_DRV_RK808=y
CONFIG_CHARGER_RK817=m
CONFIG_BATTERY_CW2015=m

# Audio: I2S1 -> RK817 codec -> AW87391 speaker amps.
CONFIG_SND_SOC_ROCKCHIP_I2S_TDM=m
CONFIG_SND_SOC_RK817=m
CONFIG_SND_SIMPLE_CARD=m
CONFIG_SND_SOC_AW87390=m

# Built-in Wi-Fi/Bluetooth: Realtek RTL8821CS (SDIO + UART).
CONFIG_RTW88=m
CONFIG_RTW88_8821CS=m
CONFIG_SERIAL_DEV_BUS=y
CONFIG_BT=m
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_SERDEV=y
CONFIG_BT_HCIUART_3WIRE=y
CONFIG_BT_HCIUART_RTL=y
CONFIG_BT_HCIBTUSB=m

# USB-C: dual role (host for adapters/hubs, gadget serial console to a PC).
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_USB_GADGET=y
CONFIG_USB_G_SERIAL=m
CONFIG_USB_CONFIGFS=m
CONFIG_USB_CONFIGFS_SERIAL=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y

# Kali: external USB Wi-Fi adapters that support monitor mode.
CONFIG_CFG80211_WEXT=y
CONFIG_MAC80211_MESH=y
CONFIG_RT2X00=m
CONFIG_RT2800USB=m
CONFIG_RT2800USB_RT3573=y
CONFIG_RT2800USB_RT53XX=y
CONFIG_RT2800USB_RT55XX=y
CONFIG_RT2800USB_UNKNOWN=y
CONFIG_ATH9K_HTC=m
CONFIG_CARL9170=m
CONFIG_MT7601U=m
CONFIG_MT76x0U=m
CONFIG_MT76x2U=m
CONFIG_MT7921U=m
CONFIG_MT7925U=m
CONFIG_RTL8187=m
CONFIG_RTL8XXXU=m
CONFIG_RTW88_8812AU=m
CONFIG_RTW88_8821AU=m
CONFIG_RTW88_8821CU=m
CONFIG_RTW88_8822BU=m
CONFIG_RTW88_8822CU=m

# USB Ethernet and USB-serial adapters.
CONFIG_USB_USBNET=m
CONFIG_USB_NET_CDCETHER=m
CONFIG_USB_NET_AX88179_178A=m
CONFIG_USB_RTL8152=m
CONFIG_USB_ACM=m
CONFIG_USB_SERIAL=m
CONFIG_USB_SERIAL_CP210X=m
CONFIG_USB_SERIAL_FTDI_SIO=m
CONFIG_USB_SERIAL_CH341=m

# Networking features the Kali tool set expects.
CONFIG_TUN=m
CONFIG_BRIDGE=m
CONFIG_WIREGUARD=m
CONFIG_NF_TABLES=m
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_CT=m
CONFIG_NFT_NAT=m
CONFIG_NFT_MASQ=m
CONFIG_NFT_COMPAT=m
CONFIG_IP_NF_IPTABLES=m
CONFIG_IP_NF_NAT=m
CONFIG_IP_NF_TARGET_MASQUERADE=m
