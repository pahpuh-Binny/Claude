<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.media3.ui.PlayerView
        android:id="@+id/video"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:resize_mode="fit"
        app:shutter_background_color="@android:color/black"
        app:use_controller="false" />

    <!-- Catches the swipe, tap, hold and pinch gestures. -->
    <View
        android:id="@+id/touch"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/bubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_chip_scrim"
        android:gravity="center"
        android:minWidth="150dp"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="14dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/bubbleIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text"
            android:textSize="26sp" />

        <TextView
            android:id="@+id/bubbleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/bubbleBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="140dp"
            android:layout_height="6dp"
            android:layout_marginTop="8dp"
            android:max="200"
            android:progressTint="@color/accent"
            android:visibility="gone" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/controls"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <View
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_gravity="top"
            android:background="@drawable/bg_scrim_top" />

        <View
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_scrim_bottom" />

        <LinearLayout
            android:id="@+id/topRow"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_gravity="top"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp">

            <ImageButton
                android:id="@+id/back"
                style="@style/Multiview.IconButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="@string/back"
                android:src="@drawable/ic_arrow_back" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="@color/text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:textColor="@color/text_dim"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/more"
                style="@style/Multiview.IconButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="@string/menu"
                android:src="@drawable/ic_more" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/centerRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/prev"
                style="@style/Multiview.IconButton"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:contentDescription="@string/previous_video"
                android:src="@drawable/ic_skip_previous" />

            <ImageButton
                android:id="@+id/rewind"
                style="@style/Multiview.IconButton"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="10dp"
                android:contentDescription="@string/back_10"
                android:src="@drawable/ic_fast_rewind" />

            <ImageButton
                android:id="@+id/play"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginHorizontal="18dp"
                android:background="@drawable/bg_play_button"
                android:contentDescription="@string/play_pause"
                android:padding="14dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_pause"
                app:tint="@color/text" />

            <ImageButton
                android:id="@+id/forward"
                style="@style/Multiview.IconButton"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginEnd="10dp"
                android:contentDescription="@string/forward_10"
                android:src="@drawable/ic_fast_forward" />

            <ImageButton
                android:id="@+id/next"
                style="@style/Multiview.IconButton"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:contentDescription="@string/next_video"
                android:src="@drawable/ic_skip_next" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/bottomArea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingHorizontal="10dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/position"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="48dp"
                    android:textColor="@color/text"
                    android:textSize="12sp" />

                <SeekBar
                    android:id="@+id/seek"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:max="1000"
                    android:progressTint="@color/accent"
                    android:thumbTint="@color/accent" />

                <TextView
                    android:id="@+id/duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:minWidth="48dp"
                    android:textColor="@color/text"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/lock"
                    style="@style/Multiview.IconButton"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:contentDescription="@string/lock_controls"
                    android:src="@drawable/ic_lock_open" />

                <ImageButton
                    android:id="@+id/loop"
                    style="@style/Multiview.IconButton"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:contentDescription="@string/loop"
                    android:src="@drawable/ic_repeat" />

                <TextView
                    android:id="@+id/ab"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/ab_repeat"
                    android:gravity="center"
                    android:minWidth="44dp"
                    android:paddingHorizontal="6dp"
                    android:text="A–B"
                    android:textColor="@color/text"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/speed"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/playback_speed"
                    android:gravity="center"
                    android:minWidth="48dp"
                    android:paddingHorizontal="6dp"
                    android:textColor="@color/text"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/aspect"
                    style="@style/Multiview.IconButton"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:contentDescription="@string/aspect"
                    android:src="@drawable/ic_aspect_ratio" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <ImageButton
        android:id="@+id/unlock"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="bottom|start"
        android:layout_margin="18dp"
        android:background="@drawable/bg_play_button"
        android:contentDescription="@string/unlock_controls"
        android:padding="14dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_lock"
        android:visibility="gone"
        app:tint="@color/text" />
</FrameLayout>
