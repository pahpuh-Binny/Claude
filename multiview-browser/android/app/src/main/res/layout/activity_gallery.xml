<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/bg"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="4dp">

                <ImageButton
                    android:id="@+id/back"
                    style="@style/Multiview.IconButton"
                    android:contentDescription="@string/close"
                    android:src="@drawable/ic_arrow_back" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:text="@string/gallery"
                        android:textColor="@color/text"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:textColor="@color/text_dim"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/prev"
                    android:layout_width="36dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/previous_page"
                    android:gravity="center"
                    android:text="‹"
                    android:textColor="@color/text"
                    android:textSize="24sp" />

                <TextView
                    android:id="@+id/next"
                    android:layout_width="36dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/next_page"
                    android:gravity="center"
                    android:text="›"
                    android:textColor="@color/text"
                    android:textSize="24sp" />

                <ImageButton
                    android:id="@+id/playAll"
                    style="@style/Multiview.IconButton"
                    android:contentDescription="@string/pause_all"
                    android:src="@drawable/ic_pause" />

                <ImageButton
                    android:id="@+id/muteAll"
                    style="@style/Multiview.IconButton"
                    android:contentDescription="@string/mute_all"
                    android:src="@drawable/ic_volume_off" />

                <ImageButton
                    android:id="@+id/hideBars"
                    style="@style/Multiview.IconButton"
                    android:contentDescription="@string/full_screen"
                    android:src="@drawable/ic_fullscreen" />

                <ImageButton
                    android:id="@+id/more"
                    style="@style/Multiview.IconButton"
                    android:layout_width="36dp"
                    android:contentDescription="@string/menu"
                    android:src="@drawable/ic_more" />
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/counts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="10dp"
                    android:paddingBottom="4dp"
                    app:selectionRequired="true"
                    app:singleLine="true"
                    app:singleSelection="true" />
            </HorizontalScrollView>
        </LinearLayout>

        <io.github.pahpuhbinny.multiview.vault.GalleryCanvas
            android:id="@+id/canvas"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/tileBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_margin="10dp"
        android:background="@drawable/bg_card"
        android:elevation="6dp"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/tileActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="4dp" />
    </HorizontalScrollView>

    <TextView
        android:id="@+id/hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_chip_scrim"
        android:gravity="center"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp"
        android:text="@string/gallery_hint"
        android:textColor="@color/text"
        android:textSize="13sp" />
</FrameLayout>
