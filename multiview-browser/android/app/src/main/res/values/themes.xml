<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Multiview" parent="Theme.Material3.Dark">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/on_accent</item>
        <item name="colorPrimaryContainer">@color/accent_dim</item>
        <item name="colorOnPrimaryContainer">@color/text</item>
        <item name="colorSecondary">@color/safe</item>
        <item name="colorOnSecondary">#06231B</item>
        <item name="colorSecondaryContainer">@color/surface3</item>
        <item name="colorOnSecondaryContainer">@color/text</item>
        <item name="colorError">@color/danger</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text</item>
        <item name="colorOnSurfaceVariant">@color/text_dim</item>
        <item name="colorSurfaceContainer">@color/surface</item>
        <item name="colorSurfaceContainerLow">@color/surface</item>
        <item name="colorSurfaceContainerHigh">@color/surface2</item>
        <item name="colorSurfaceContainerHighest">@color/surface3</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/outline</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="actionBarStyle">@style/Widget.Multiview.ActionBar</item>
    </style>

    <style name="Widget.Multiview.ActionBar" parent="Widget.Material3.ActionBar.Solid">
        <item name="background">@color/bg</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Theme.Multiview.Main" parent="Theme.Multiview">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.Multiview.Player" parent="Theme.Multiview.Main">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>

    <style name="Multiview.IconButton" parent="Widget.AppCompat.ImageButton">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:scaleType">center</item>
        <item name="tint">@color/text</item>
    </style>
</resources>
